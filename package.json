{
  "name": "pharmax",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter pharmacy-os dev",
    "worker:dev": "pnpm --filter pharmacy-worker dev",
    "worker:start": "pnpm --filter pharmacy-worker start",
    "print-agent:dev": "pnpm --filter pharmacy-print-agent dev",
    "print-agent:start": "pnpm --filter pharmacy-print-agent start",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm --filter @pharmax/integration-tests test",
    "test:integration:watch": "pnpm --filter @pharmax/integration-tests test:watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "prisma:validate": "DATABASE_URL=\"postgresql://validate:validate@localhost:5432/validate\" DIRECT_URL=\"postgresql://validate:validate@localhost:5432/validate\" prisma validate",
    "prisma:format": "DATABASE_URL=\"postgresql://validate:validate@localhost:5432/validate\" DIRECT_URL=\"postgresql://validate:validate@localhost:5432/validate\" prisma format",
    "check:migrations": "tsx scripts/check-migration-rls.ts",
    "check:drift": "tsx scripts/check-prisma-drift.ts",
    "check:schema": "tsx scripts/check-prisma-schema.ts",
    "check:commands": "tsx scripts/check-command-files.ts",
    "check:kms-inventory": "tsx scripts/check-kms-inventory.ts",
    "check:alarm-actions": "tsx scripts/check-alarm-actions.ts",
    "check:raw-prisma": "tsx scripts/check-raw-prisma-usage.ts",
    "check:raw-sql": "tsx scripts/check-raw-sql-usage.ts",
    "check:caught-cause": "tsx scripts/check-caught-error-cause.ts",
    "check:layers": "tsx scripts/check-package-layers.ts",
    "check:seed": "tsx scripts/check-seed-fixtures.ts",
    "check:wip": "tsx scripts/check-wip.ts",
    "session:new": "sh scripts/session-new.sh",
    "check:terraform-apply-workflow": "tsx scripts/check-terraform-apply-workflow.ts",
    "events:validate": "tsx scripts/events/validate-registry.ts",
    "events:migrate-check": "tsx scripts/events/migrate-allowlist.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm prisma:validate && pnpm check:migrations && pnpm check:drift && pnpm check:schema && pnpm check:commands && pnpm check:kms-inventory && pnpm check:alarm-actions && pnpm check:raw-prisma && pnpm check:raw-sql && pnpm check:caught-cause && pnpm check:layers && pnpm check:terraform-apply-workflow && pnpm events:validate && pnpm events:migrate-check && pnpm test",
    "verify:fast": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:org": "tsx scripts/bootstrap-org.ts",
    "resolve:emergency": "tsx scripts/resolve-emergency-bucket.ts",
    "outbox:republish": "tsx scripts/operations/republish-dead-outbox.ts",
    "payments:backfill": "tsx scripts/operations/backfill-payment-ledger.ts",
    "rxnorm:ingest": "tsx scripts/operations/ingest-rxnorm-release.ts",
    "verify:kms": "tsx scripts/security/verify-kms-keys.ts",
    "security:sign-merkle": "tsx scripts/security/sign-daily-merkle-root.ts",
    "security:verify-merkle": "tsx scripts/security/verify-merkle-manifest.ts",
    "security:verify-chain-all": "tsx scripts/security/verify-audit-chain-all-orgs.ts",
    "drill:preflight": "tsx scripts/operations/run-restore-drill.ts --phase=preflight",
    "drill:provision-commands": "tsx scripts/operations/run-restore-drill.ts --phase=provision-commands",
    "drill:verify": "tsx scripts/operations/run-restore-drill.ts --phase=verify",
    "drill:teardown-commands": "tsx scripts/operations/run-restore-drill.ts --phase=teardown-commands",
    "drill:finalize": "tsx scripts/operations/run-restore-drill.ts --phase=finalize",
    "chaos:snapshot": "tsx scripts/operations/run-chaos-drill.ts --phase=snapshot",
    "chaos:finalize": "tsx scripts/operations/run-chaos-drill.ts --phase=finalize",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "postinstall": "pnpm db:generate",
    "status": "git status"
  },
  "//prisma": "Prisma CLI config (schema/migrations/seed/datasource) lives in prisma.config.ts as of Prisma 7.",
  "devDependencies": {
    "@aws-sdk/client-kms": "^3.1105.0",
    "@aws-sdk/client-rds": "^3.1103.0",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@eslint/js": "^10.0.1",
    "@pharmax/audit": "workspace:*",
    "@pharmax/billing": "workspace:*",
    "@pharmax/clinical-screening": "workspace:*",
    "@pharmax/command-bus": "workspace:*",
    "@pharmax/compliance": "workspace:*",
    "@pharmax/composition": "workspace:*",
    "@pharmax/crypto": "workspace:*",
    "@pharmax/database": "workspace:*",
    "@pharmax/documents": "workspace:*",
    "@pharmax/drug-knowledge": "workspace:*",
    "@pharmax/events": "workspace:*",
    "@pharmax/fill": "workspace:*",
    "@pharmax/integration-tests": "workspace:*",
    "@pharmax/labels": "workspace:*",
    "@pharmax/notifications": "workspace:*",
    "@pharmax/order-contracts": "workspace:*",
    "@pharmax/orders": "workspace:*",
    "@pharmax/orgs": "workspace:*",
    "@pharmax/package-capture": "workspace:*",
    "@pharmax/patients": "workspace:*",
    "@pharmax/platform-core": "workspace:*",
    "@pharmax/providers": "workspace:*",
    "@pharmax/rbac": "workspace:*",
    "@pharmax/reporting": "workspace:*",
    "@pharmax/scan": "workspace:*",
    "@pharmax/security": "workspace:*",
    "@pharmax/shipping": "workspace:*",
    "@pharmax/sla": "workspace:*",
    "@pharmax/telemetry": "workspace:*",
    "@pharmax/tenancy": "workspace:*",
    "@pharmax/verification": "workspace:*",
    "@pharmax/workflow": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/generator-helper": "^7.9.1",
    "@prisma/internals": "^7.9.1",
    "@types/node": "22.20.1",
    "@types/pg": "^8.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.6.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
