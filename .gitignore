# dependencies
node_modules/
.pnpm-store/

# environment / secrets
.env
.env.*
!.env.example
!.env.local.example

# build outputs
.next/
dist/
build/
coverage/
*.tsbuildinfo

# Prisma generated client (re-generated on `pnpm install` / `pnpm db:generate`)
packages/database/src/generated/

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OS/editor
.DS_Store
.vscode/settings.json

# Cursor local/private config
.cursor/mcp.json
.cursor/*.local.json

# local databases
*.db
*.sqlite
*.sqlite3

# test artifacts
playwright-report/
test-results/

# Lockfile copies written by a merge/stash recovery. Operator-local
# debris — the real lockfile is pnpm-lock.yaml.
.lockfile-recovery/

# Terraform — never commit state, .tfvars, or filled backend configs.
# Only the *.example templates are checked in. Patterns cover both the
# top-level `terraform/` tree (the canonical IaC location) and the
# legacy `infra/terraform/` tree.
terraform/**/.terraform/
terraform/**/.terraform.lock.hcl
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.*
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfplan
terraform/**/tfplan
terraform/**/terraform.tfvars
terraform/**/*.auto.tfvars
terraform/**/*.auto.tfvars.json
terraform/**/backend.tf
!terraform/**/backend.tf.example
!terraform/**/terraform.tfvars.example
!terraform/backend.tf.example
infra/terraform/**/.terraform/
infra/terraform/**/.terraform.lock.hcl
infra/terraform/**/terraform.tfstate
infra/terraform/**/terraform.tfstate.*
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfplan
infra/terraform/**/tfplan
infra/terraform/**/terraform.tfvars
infra/terraform/**/*.auto.tfvars
infra/terraform/**/backend.tf
!infra/terraform/**/backend.tf.example
!infra/terraform/**/terraform.tfvars.example
!infra/terraform/backend.tf.example
# Env-region tfvars AND backend.tf ARE committed: the terraform-apply
# workflow's CI plan job needs both — tfvars carry sizing/domains/feature
# flags, backend.tf carries state-bucket coordinates (bucket/lock-table
# names + KMS ARN). Neither holds secrets (those live in Secrets Manager;
# see the no-secrets-in-code policy). Without a committed backend.tf the
# CI plan inits an EMPTY local state and plans the whole stack from
# scratch (caught by the expected_changes gate on the first real run).
!infra/terraform/environments/*/*/terraform.tfvars
!infra/terraform/environments/*/*/backend.tf

# DR-drill evidence is operator-local, never committed (see docs/soc2/evidence-inventory.md)
evidence/
